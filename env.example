# Συμπλήρωσε το Gemini API key σου σε αυτό το τοπικό αρχείο.
# Μετονόμασε το αρχείο σε .env (ή χρησιμοποίησε INSTALL_WINDOWS.bat).
# ΜΗΝ ανεβάζεις το .env στο GitHub / cloud.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
# Αν το επιλεγμένο μοντέλο δεν υποστηρίζεται από το project/key σου,
# μπορείς να το αλλάξεις εδώ.
GEMINI_MODEL=gemini-3.8-flash
